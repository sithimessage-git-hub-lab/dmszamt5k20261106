# ========== 目标设备配置 ==========

CONFIG_TARGET_mediatek=y

CONFIG_TARGET_mediatek_filogic=y

CONFIG_TARGET_mediatek_filogic_DEVICE_glinet_gl-mt5000=y

# ========== 固件格式配置 ==========

CONFIG_TARGET_IMAGES_GZIP=y

# ========== LuCI Web 界面 ==========

# LuCI 基础组件

CONFIG_PACKAGE_luci=y

CONFIG_PACKAGE_luci-ssl=y

CONFIG_PACKAGE_luci-compat=y

CONFIG_PACKAGE_luci-lib-base=y

CONFIG_PACKAGE_luci-lib-ip=y

CONFIG_PACKAGE_luci-lib-jsonc=y

CONFIG_PACKAGE_luci-lib-nixio=y

# LuCI 标准主题

CONFIG_PACKAGE_luci-theme-bootstrap=y

# LuCI 常用页面模块

CONFIG_PACKAGE_luci-mod-admin-full=y

CONFIG_PACKAGE_luci-mod-network=y

CONFIG_PACKAGE_luci-mod-status=y

CONFIG_PACKAGE_luci-mod-system=y

# LuCI 基本功能页面

CONFIG_PACKAGE_luci-app-firewall=y

CONFIG_PACKAGE_luci-app-opkg=y

CONFIG_PACKAGE_luci-app-upnp=y

# LuCI 默认首页

CONFIG_PACKAGE_luci-base=y

# 简体中文语言包

CONFIG_LUCI_LANG_zh_Hans=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

CONFIG_PACKAGE_luci-i18n-package-manager-zh-cn=y

# ========== UPnP 端口自动转发 ==========

# UPnP 服务核心守护进程（nftables 版，IGD 实现，必需依赖）

CONFIG_PACKAGE_miniupnpd-nftables=y

# LuCI 的 UPnP 管理界面

CONFIG_PACKAGE_luci-app-upnp=y

# LuCI UPnP 中文语言包

CONFIG_PACKAGE_luci-i18n-upnp-zh-cn=y

# ========== WOL 网络唤醒 ==========

# WOL 魔术包发送工具（必需依赖）

CONFIG_PACKAGE_etherwake=y

# LuCI 的 WOL 管理界面

CONFIG_PACKAGE_luci-app-wol=y

# LuCI WOL 中文语言包

CONFIG_PACKAGE_luci-i18n-wol-zh-cn=y

# ========== WireGuard 支持 ==========

# WireGuard 内核模块（必需）

CONFIG_PACKAGE_kmod-wireguard=y

# WireGuard 命令行工具

CONFIG_PACKAGE_wireguard-tools=y

# LuCI 的 WireGuard 管理界面

CONFIG_PACKAGE_luci-proto-wireguard=y

# ========== 代理/TUN 模式支持 ==========

# TUN/TAP 虚拟网络设备（TUN 模式代理必需）

CONFIG_PACKAGE_kmod-tun=y

# INET socket 监控（ss 工具及部分代理插件依赖）

CONFIG_PACKAGE_kmod-inet-diag=y

# Netlink 诊断（ss 工具及部分代理插件依赖）

CONFIG_PACKAGE_kmod-netlink-diag=y

# ========== DNS / 网络工具支持 ==========

# dnsmasq 完整版（支持 ipset/nft set 分流，代理插件依赖）

CONFIG_PACKAGE_dnsmasq-full=y

# 完整版 ip 命令（提供 ip-full 功能）

CONFIG_PACKAGE_ip-full=y

# ========== TPROXY 透明代理支持 ==========

# nftables tproxy 表达式（透明代理必需）

CONFIG_PACKAGE_kmod-nft-tproxy=y

# nftables socket 匹配（透明代理必需）

CONFIG_PACKAGE_kmod-nft-socket=y

# ========== iptables/nftables 兼容与流控支持 ==========

CONFIG_PACKAGE_kmod-ipt-core=y

CONFIG_PACKAGE_kmod-nft-compat=y

CONFIG_PACKAGE_kmod-ipt-conntrack-extra=y

CONFIG_PACKAGE_kmod-ipt-ipopt=y

CONFIG_PACKAGE_kmod-ifb=y

CONFIG_PACKAGE_kmod-sched-connmark=y

CONFIG_PACKAGE_kmod-sched-core=y

CONFIG_PACKAGE_kmod-sched-cake=y

# ========== DDNS 动态域名 ==========

# DDNS 核心脚本

CONFIG_PACKAGE_ddns-scripts=y

# DDNS 服务商配置（cloudflare、dnspod 等服务商脚本）

CONFIG_PACKAGE_ddns-scripts-services=y

# LuCI 的 DDNS 管理界面

CONFIG_PACKAGE_luci-app-ddns=y

# LuCI DDNS 中文语言包

CONFIG_PACKAGE_luci-i18n-ddns-zh-cn=y

# ========== SQM 智能队列管理 ==========

# SQM 核心脚本（CAKE/FQ-CoDel 队列调度）

CONFIG_PACKAGE_sqm-scripts=y

# LuCI 的 SQM 管理界面

CONFIG_PACKAGE_luci-app-sqm=y

# LuCI SQM 中文语言包

CONFIG_PACKAGE_luci-i18n-sqm-zh-cn=y

# ========== 流量监控 ==========

# nlbwmon 流量监控守护进程

CONFIG_PACKAGE_nlbwmon=y

# LuCI 的 nlbwmon 界面

CONFIG_PACKAGE_luci-app-nlbwmon=y

# LuCI nlbwmon 中文语言包

CONFIG_PACKAGE_luci-i18n-nlbwmon-zh-cn=y

# LuCI 流量统计（collectd 后端 + 图表）

CONFIG_PACKAGE_luci-app-statistics=y

# LuCI 流量统计中文语言包

CONFIG_PACKAGE_luci-i18n-statistics-zh-cn=y

# collectd 温度采集模块（CPU/设备温度监控）

CONFIG_PACKAGE_collectd-mod-thermal=y

# vnStat2 网络流量统计工具

CONFIG_PACKAGE_luci-app-vnstat2=y

# LuCI vnstat2 中文语言包

CONFIG_PACKAGE_luci-i18n-vnstat2-zh-cn=y

# LuCI ttyd app及其中文语言包

CONFIG_PACKAGE_ttyd=y

CONFIG_PACKAGE_luci-app-ttyd=y

CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y
